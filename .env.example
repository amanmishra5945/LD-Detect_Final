# ============================================================
# Smart Learning Disability Screening System — Environment Variables
# ============================================================

# Server Port and Host
HOST=0.0.0.0
PORT=8000

# Database Connection URL
# SQLite default: sqlite:///ld_detection.db
# PostgreSQL example: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///ld_detection.db

# CORS Allowed Origins (comma-separated, default is "*" for development)
# Production example: https://my-screening-app.com,https://admin.my-screening-app.com
ALLOWED_ORIGINS=*

# Speech Provider: "browser" (Web Speech API) or "whisper"
SPEECH_PROVIDER=browser

# Audio storage (Privacy protection: keep false unless explicit consent)
STORE_RAW_AUDIO=false
